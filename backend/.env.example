ANTHROPIC_API_KEY=your-anthropic-api-key-here
LLM_MODEL=claude-sonnet-5

# Where alarms come from:
#   http (default) -- the remote alarm source configured by the SOURCE_* variables below
#   mock           -- purely synthetic demo data (data/mock_security_data.json), no server needed
DATA_PROVIDER=http
# Paths default to data/ at the project root -- only override MOCK_DATA_PATH /
# MITRE_TACTICS_PATH if you're pointing at a different file.

# --- Alarm data source (DATA_PROVIDER=http) -------------------------------------
# The source is configured from the app (Fuente de Datos, admins only): protocol, host/IP,
# paths of the Alertas and Notificaciones endpoints, user, password and options. Those values
# live in Supabase (in_source_settings) and take precedence; the SOURCE_* below only bootstrap
# a fresh install and are optional. Never put the source address or credentials in code.
#
# Encrypts the source password stored in Supabase. REQUIRED to save credentials from the app.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SOURCE_SECRET_KEY=
# Albatrus SOC server. It is served over plain http today: credentials and alarm data
# travel unencrypted, so only use it over the VPN/LAN and ask for https when possible.
SOURCE_BASE_URL=http://10.2.85.8/ProyectoSOC/views
SOURCE_USERNAME=your-source-username
SOURCE_PASSWORD=your-source-password
# The source asks for a login form (PHP session); the client fills it in by itself with
# these credentials (Basic Auth only if the server asks for it) -- nothing else to configure.
# Endpoint paths: relative to SOURCE_BASE_URL, or a full http(s) URL if one endpoint
# lives on another host.
#SOURCE_ALARMS_PATH=/detallado_alarmas.php
#SOURCE_INDICATORS_PATH=/indicadores.php
# Cross-check every download against the indicators page (same client and period):
# warns if the totals differ and refuses an empty export when the dashboard lists alarms.
#SOURCE_RECONCILE_INDICATORS=true
# Verify the server's TLS certificate when the source is https (keep true). For an internal
# server with its own CA, set SOURCE_CA_BUNDLE to that CA file rather than disabling verification.
SOURCE_VERIFY_TLS=true
#SOURCE_CA_BUNDLE=/path/to/internal-ca.pem
#SOURCE_TIMEOUT_SECONDS=30
# Row limit sent as limite= (a response with exactly this many rows is flagged as possibly truncated)
#SOURCE_ALARMS_LIMIT=1000
# How long fetched alarms are reused before asking the source again
#SOURCE_CACHE_TTL_SECONDS=300

CORS_ORIGINS=["http://localhost:5173"]

# Supabase: Auth (sign-in) + Database (app data, configuration, audit, observability).
# The anon/publishable key only identifies the project; every query runs with the signed-in
# user's token and RLS allows only active members of this app (in_users). No service-role key.
# The frontend needs the same URL + key as VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here


# Set to "production" to enable startup warnings (SECURITY_REVIEW.md), e.g. if
# CORS_ORIGINS still points at localhost.
# Behind a reverse proxy that sets X-Forwarded-For, record the real client IP in the audit log:
#TRUST_PROXY_HEADERS=true
ENVIRONMENT=development

# Optional: stamps in_agent_executions.system_version with this value instead of
# reading `git rev-parse HEAD` at runtime -- set this at container build time
# (most Dockerfiles don't COPY .git, so the git fallback won't resolve inside one).
# SYSTEM_VERSION=
