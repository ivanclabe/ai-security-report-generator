ANTHROPIC_API_KEY=your-anthropic-api-key-here
LLM_MODEL=claude-sonnet-5

# "excel" (default) reads data/thomas_tgs_tps_alarmas_julio.xlsx (synthetic client data).
# Set to "mock" to use the purely synthetic data/mock_security_data.json instead.
# Paths default to data/ at the project root -- only override EXCEL_DATA_PATH /
# MOCK_DATA_PATH / MITRE_TACTICS_PATH if you're pointing at a different file.
DATA_PROVIDER=excel

CORS_ORIGINS=["http://localhost:5173"]

# Supabase project storing conversations/messages/reports (tables prefixed "in_").
# The anon key is used server-side only (never sent to the frontend); RLS policies
# on the in_* tables grant it access scoped to just those tables.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Single hardcoded operator login (not per-user accounts) + JWT signing secret.
# Change AUTH_SECRET_KEY to a random value in any real deployment.
AUTH_USERNAME=master
AUTH_PASSWORD=123456
AUTH_SECRET_KEY=change-me-to-a-random-secret

# Set to "production" to enable startup warnings (SECURITY_REVIEW.md) if
# AUTH_SECRET_KEY/AUTH_PASSWORD are still at their insecure defaults, or
# CORS_ORIGINS still points at localhost.
ENVIRONMENT=development

# Optional: stamps in_agent_executions.system_version with this value instead of
# reading `git rev-parse HEAD` at runtime -- set this at container build time
# (most Dockerfiles don't COPY .git, so the git fallback won't resolve inside one).
# SYSTEM_VERSION=
